# Copy to .env, then choose one COMPOSE_FILE line. Compose reads .env automatically.
# Pi Box only (also the default when .env does not exist):
COMPOSE_FILE=compose.yaml

# Pi Box with PostgreSQL (uncomment this and comment the Pi-only line above):
# COMPOSE_FILE=compose.yaml:compose.postgres.yaml
# Set your own private password when enabling PostgreSQL:
# POSTGRES_PASSWORD='replace-with-your-own-strong-password'
# Single quotes keep characters such as $ literal instead of interpolating them.
# Keep .env private: chmod 600 .env

# Optional image/storage overrides also belong here; no Makefile edits needed.
# TARGET=base
# IMAGE=pi-box:0.2.0-base
# COMPOSE_PROJECT_NAME=another-pi-box
# CONTAINER=another-pi-box-main-container
# PostgreSQL's container name follows COMPOSE_PROJECT_NAME: <project>-postgres-container.
# WORKSPACE_VOLUME=another-pi-box-workspace
# AGENT_VOLUME=another-pi-box-agent
# GIT_VOLUME=another-pi-box-git
