# Copy to .env; Compose reads it automatically. Keep it private: chmod 600 .env
# Single quotes keep characters such as $ literal instead of interpolating them.

# Services: compose.yaml alone is Pi Box only (also the default without .env).
# Add optional services by appending overlays with ":", for example
# COMPOSE_FILE=compose.yaml:compose.postgres.yaml:compose.browserless.yaml
# Stop a sidecar before removing its overlay. Review the README before enabling:
# Browserless uses SSPL/commercial terms and disables Chromium's sandbox, and
# Phoenix full-content traces can retain private data and secrets.
COMPOSE_FILE=compose.yaml

# Required by compose.postgres.yaml:
# POSTGRES_PASSWORD='replace-with-your-own-strong-password'
# Required by compose.browserless.yaml:
# BROWSER_TOKEN='your-own-strong-private-token'
# compose.phoenix.yaml needs explicit pi-otel setup (docs/phoenix.md).

# Host loopback ports; change them for each simultaneous Pi Box instance.
# Ten host ports mapped in order to container ports 5173-5182.
# DEV_PORTS=5173-5182
# PHOENIX_UI_PORT=6006

# Optional image/storage overrides; no Makefile edits needed.
# TARGET=base
# IMAGE=pi-box:0.2.0-base
# COMPOSE_PROJECT_NAME=another-pi-box
# CONTAINER=another-pi-box-main-container
# PostgreSQL's container name follows COMPOSE_PROJECT_NAME: <project>-postgres-container.
# WORKSPACE_VOLUME=another-pi-box-workspace
# AGENT_VOLUME=another-pi-box-agent
# GIT_VOLUME=another-pi-box-git
# HERDR_VOLUME=another-pi-box-herdr
