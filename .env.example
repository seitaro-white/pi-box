# Copy to .env, then choose one COMPOSE_FILE line. Compose reads .env automatically.
# Pi Box only (also the default when .env does not exist):
COMPOSE_FILE=compose.yaml

# Pi Box with PostgreSQL (uncomment this and comment the Pi-only line above):
# COMPOSE_FILE=compose.yaml:compose.postgres.yaml
# Set your own private password when enabling PostgreSQL:
# POSTGRES_PASSWORD='replace-with-your-own-strong-password'
# Single quotes keep characters such as $ literal instead of interpolating them.
# Keep .env private: chmod 600 .env

# Pi + Browserless Chromium (alternative selection):
# COMPOSE_FILE=compose.yaml:compose.browserless.yaml
# BROWSER_TOKEN='your-own-strong-private-token'

# Pi + PostgreSQL + Browserless Chromium (alternative selection):
# COMPOSE_FILE=compose.yaml:compose.postgres.yaml:compose.browserless.yaml
# Also configure POSTGRES_PASSWORD and BROWSER_TOKEN privately.
# Browserless uses SSPL/commercial terms and disables Chromium's sandbox.
# Review the README before enabling it.

# Pi Box with Phoenix trace viewing (explicit pi-otel setup; see docs/phoenix.md):
# COMPOSE_FILE=compose.yaml:compose.phoenix.yaml
# Or PostgreSQL and Phoenix together (also set POSTGRES_PASSWORD above):
# COMPOSE_FILE=compose.yaml:compose.postgres.yaml:compose.phoenix.yaml
# Or Browserless and Phoenix together (also set BROWSER_TOKEN above):
# COMPOSE_FILE=compose.yaml:compose.browserless.yaml:compose.phoenix.yaml
# Or all optional services (also set POSTGRES_PASSWORD and BROWSER_TOKEN above):
# COMPOSE_FILE=compose.yaml:compose.postgres.yaml:compose.browserless.yaml:compose.phoenix.yaml
# Phoenix full-content traces can retain private data and secrets; explicitly opt in.
# Phoenix UI is published only on host loopback; change the port for another instance:
# PHOENIX_UI_PORT=6006

# Optional image/storage overrides also belong here; no Makefile edits needed.
# TARGET=base
# IMAGE=pi-box:0.2.0-base
# COMPOSE_PROJECT_NAME=another-pi-box
# CONTAINER=another-pi-box-main-container
# PostgreSQL's container name follows COMPOSE_PROJECT_NAME: <project>-postgres-container.
# WORKSPACE_VOLUME=another-pi-box-workspace
# AGENT_VOLUME=another-pi-box-agent
# GIT_VOLUME=another-pi-box-git
# HERDR_VOLUME=another-pi-box-herdr
